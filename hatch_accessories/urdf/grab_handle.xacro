<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="grab_handle" params="
    prefix:=''
    parent:=''
    *origin">

    <joint name="${prefix}grab_handle_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}grab_handle"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}grab_handle">
      <!--TODO set proper inertia-->
      <inertial>
        <origin xyz="0.06460542 -0.08890724 0.0" rpy="0 0 0"/>
        <mass value="0.1558987"/>
        <inertia ixx="0.0008422355" ixy="0.00000001340204" ixz="0.000000002477554" iyy="0.0001004532" iyz="0.00000006036754" izz="0.0009303066"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/visual/imetro_hatch_handle.dae"/>
        </geometry>
        <material name="${prefix}grab_handle_texture">
          <texture filename="package://hatch_accessories/meshes/visual/grab_handle_texture.png"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle.stl"/>
        </geometry>
        <material name="red"/>
      </collision>
    </link>

    <joint name="${prefix}grab_center_joint" type="fixed">
      <parent link="${prefix}grab_handle"/>
      <child link="${prefix}grab_center"/>
      <origin xyz="0.0807 -0.0889 0.0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}grab_center"/>

    <joint name="${prefix}grab_touch_joint" type="fixed">
      <parent link="${prefix}grab_handle"/>
      <child link="${prefix}grab_touch"/>
      <origin xyz="0.0934 -0.0889 0.0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}grab_touch"/>

  </xacro:macro>

  <!-- Grab handles are thin, convex-decomposed meshes that can "catch" on a gripper's own convex-decomposed
       fingertip meshes, needing a surprisingly long time/force to separate from an open grasp.
       priority="1" makes this friction value win over whatever other contacting geoms specify. -->
  <xacro:property name="grab_handle_contact_friction" value="0.3 0.005 0.0001"/>
  <xacro:macro name="_grab_handle_decomp_friction" params="index">
    <modify_element type="geom" mesh="grab_handle_decomp_${index}" class="collision"
      friction="${grab_handle_contact_friction}" priority="1"/>
  </xacro:macro>

  <xacro:macro name="grab_handle_mj_processed_inputs" params="
    prefix:=''
    ">
    <replace_collision link="${prefix}grab_handle" stage="urdf">
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_0.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_1.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_2.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_3.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_4.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_5.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_6.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_7.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_8.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_9.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_10.stl"/>
        </geometry>
      </collision>
      <collision>
        <geometry>
          <mesh filename="package://hatch_accessories/meshes/collision/grab_handle/grab_handle_decomp_11.stl"/>
        </geometry>
      </collision>
    </replace_collision>

    <xacro:_grab_handle_decomp_friction index="0"/>
    <xacro:_grab_handle_decomp_friction index="1"/>
    <xacro:_grab_handle_decomp_friction index="2"/>
    <xacro:_grab_handle_decomp_friction index="3"/>
    <xacro:_grab_handle_decomp_friction index="4"/>
    <xacro:_grab_handle_decomp_friction index="5"/>
    <xacro:_grab_handle_decomp_friction index="6"/>
    <xacro:_grab_handle_decomp_friction index="7"/>
    <xacro:_grab_handle_decomp_friction index="8"/>
    <xacro:_grab_handle_decomp_friction index="9"/>
    <xacro:_grab_handle_decomp_friction index="10"/>
    <xacro:_grab_handle_decomp_friction index="11"/>
  </xacro:macro>
</robot>
